# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BIOSITE NFC (EXEMPLO)
# NUNCA insira dados ou senhas reais de produção neste arquivo.
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# ==============================================================================

# Módulo de configurações ativo:
# Desenvolvimento: configuracao.settings.desenvolvimento
# Produção:       configuracao.settings.producao
# Testes:          configuracao.settings.teste
DJANGO_SETTINGS_MODULE=configuracao.settings.desenvolvimento

# Chave secreta da aplicação (OBRIGATÓRIA em produção, gere com django.core.management.utils.get_random_secret_key)
DJANGO_SECRET_KEY=django-insecure-chave-apenas-para-desenvolvimento-local-troque-em-producao

# Modo de depuração (NUNCA ative em produção)
DJANGO_DEBUG=True

# Hosts autorizados (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origens confiáveis para CSRF (separadas por vírgula, ex: https://meubiosite.com.br)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados (URL no padrão 12-factor)
# SQLite (desenvolvimento padrão):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (recomendado para produção):
# DATABASE_URL=postgres://usuario:senha@localhost:5432/biosite_db

# Configurações de Segurança HTTPS (ativas por padrão em producao.py, ajustáveis via env se necessário)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
